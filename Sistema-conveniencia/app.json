{
  "expo": {
    "name": "Brasileirinho",
    "slug": "Sistema-conveniencia",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/Logo.jpg",
    "scheme": "sistemaconveniencia",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFE800",
        "foregroundImage": "./assets/images/Logo.jpg"
      },
      "package": "com.gmrrbisolutions.brasileirinho",
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/Logo.jpg"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/Logo.jpg",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#FFE800",
          "dark": {
            "backgroundColor": "#121212"
          }
        }
      ],
      "expo-sqlite"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "dc60b1a7-389b-4967-b495-ea3393af7f5f"
      }
    }
  }
}